{
  "rules": {
    "catalogo": {
      ".read": true,
      ".write": true,
      ".validate": "newData.child('v').isNumber() && newData.child('v').val() >= 2"
    },
    "pedidos": {
      ".read": true,
      ".write": true,
      "$pedidoId": {
        ".validate": "newData.hasChildren(['fecha', 'items', 'total', 'estado', 'pagado']) && newData.child('total').isNumber() && newData.child('pagado').isNumber() && newData.child('estado').val().matches(/^(none|adelanto|completo)$/)"
      }
    },
    "$otro": {
      ".read": false,
      ".write": false
    }
  }
}
